# 复制为 .env.local 后填写自己的密钥，禁止提交真实配置。
DASHSCOPE_API_KEY=
# 随机固定签名密钥，生产环境至少32字符。
AUTH_SECRET=
# 私密六位大写邀请码，多个用逗号分隔；留空关闭新注册。
INVITE_CODES=
LLM_MODEL=qwen3.7-flash
INTENT_MODEL=tongyi-intent-detect-v3
COMPANION_MODEL=qwen-flash-character
COMPANION_BASE_URL=
# 自备私有知识库目录，不随仓库或运行包分发。
HANFU_RAG_DATA_DIR=
AUTH_USERS_FILE=
FUZHANG_PYTHON=

# 可选私有摘录文件，不随代码发布。
HANFU_COMPANION_QUOTES_FILE=
